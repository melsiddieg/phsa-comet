# COMET production environment — copy to `modern/.env.production` and fill in.
#
#   cp docker/production/.env.production.example .env.production
#   chmod 600 .env.production
#
# This file is read by Compose (--env-file), NOT baked into the image.
# Never commit the filled-in copy.

# ── Required ────────────────────────────────────────────────────────────────
# Generate once and keep forever. Changing it invalidates every session and
# any encrypted column:  openssl rand -base64 32
APP_KEY=base64:CHANGE_ME

# Public URL users hit (used for links, redirects, SSO callback)
APP_URL=https://comet.example.org

# ── Networking ──────────────────────────────────────────────────────────────
# Host port for the app. Keep this on loopback: Caddy (below) terminates TLS
# and proxies to it, so the app itself must not be reachable from outside.
# Only use a bare `8080` for a throwaway test with no TLS.
HTTP_PORT=127.0.0.1:8080

# ── Database ────────────────────────────────────────────────────────────────
DB_DATABASE=comet
DB_USERNAME=comet_app
# The password is NOT set here — it comes from the Docker secret file
# (secrets/pg_app_pw.txt). See PG_PASSWORD_FILE below.

# ── Paths (relative to docker/production/) ──────────────────────────────────
PG_PASSWORD_FILE=../../../secrets/pg_app_pw.txt
VOCAB_DATA_DIR=../../../vocab_data

# ── Image ───────────────────────────────────────────────────────────────────
# Set to a registry tag to deploy a prebuilt image instead of building locally
# COMET_IMAGE=ghcr.io/melsiddieg/comet:1.4.0
COMET_IMAGE=comet:latest

# ── TLS — used by compose.caddy.yaml (the default deployment) ───────────────
# Public hostname. Its DNS A/AAAA record must ALREADY point at this server
# before you start Caddy — a failed ACME challenge counts against Let's
# Encrypt rate limits. Verify with:  dig +short comet.example.org
COMET_DOMAIN=comet.example.org
# Let's Encrypt expiry notices go here.
ACME_EMAIL=ops@example.org
# Leave empty to obtain a certificate automatically via ACME.
# If the network blocks ACME (Caddy logs "connection reset by peer" against
# acme.zerossl.com / letsencrypt.org), supply your own certificate instead —
# put tls.crt and tls.key in docker/production/certs/ and set:
#   COMET_TLS=tls /etc/caddy/certs/tls.crt /etc/caddy/certs/tls.key
# For internal testing only (browsers will warn): COMET_TLS=tls internal
COMET_TLS=

# ── Behind an EXISTING reverse proxy (compose.proxy.yaml) ───────────────────
# Use when another container already owns port 80 on this host. COMET then
# publishes no host ports; the proxy reaches it as `app:8080`.
# Find it with:
#   docker inspect -f '{{range $n,$_ := .NetworkSettings.Networks}}{{$n}} {{end}}' <proxy>
# PROXY_NETWORK=web
#
# Running alongside OHDSI Broadsea 3? Use compose.broadsea.yaml instead and set:
#   PROXY_NETWORK=broadsea_default   (verify: docker inspect traefik)
#   COMET_DOMAIN=comet.example.org   (a DEDICATED hostname - not a /path,
#                                     which breaks Livewire; see README)
#   COMET_ENTRYPOINT=http            (match Broadsea's HTTP_TYPE)

# ── Wrapper ─────────────────────────────────────────────────────────────────
# Which overlay ./docker/production/comet includes automatically:
#   caddy     bundled Caddy + Let's Encrypt (default, dedicated server)
#   proxy     an existing reverse proxy already owns :80
#   broadsea  alongside an OHDSI Broadsea 3 stack
#   none      base stack only, no TLS layer
COMET_OVERLAY=caddy

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=warning

# ── Entra ID SSO ────────────────────────────────────────────────────────────
# Leave AUTH_LOCAL_LOGIN=1 only until SSO is verified, then set it to 0.
AUTH_LOCAL_LOGIN=0
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
